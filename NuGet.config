<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Il NuGet.Config utente (%AppData%\NuGet\NuGet.Config) non elenca nessuna origine:
       senza questo file il restore di FluentFTP fallisce con NU1100. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
